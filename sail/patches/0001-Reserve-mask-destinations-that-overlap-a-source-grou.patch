      not(valid_vm_src_overlap(0b0, vs1, SEW)) |
-     not(valid_vm_src_overlap(0b0, vs2, SEW))
+     not(valid_vm_src_overlap(0b0, vs2, SEW)) |
+     not(valid_mask_dest_overlap(vd, vs1, LMUL_pow)) |
+     not(valid_mask_dest_overlap(vd, vs2, LMUL_pow))
   then return Illegal_Instruction();
 
   let 'n = num_elem;
@@ -54,7 +56,7 @@ function clause execute VVMTYPE(funct6, vs2, vs1, vd) = {
   foreach (i from 0 to (num_elem - 1)) {
     if mask[i] == 0b1 then {
       let res : bool = match funct6 {
-        VVM_VMADC    => unsigned(vs2_val[i]) + unsigned(vs1_val[i]) + (if vm_val[i] == 0b1 then 1 else 0) > 2 ^ SEW - 1,
+        VVM_VMADC   => unsigned(vs2_val[i]) + unsigned(vs1_val[i]) + (if vm_val[i] == 0b1 then 1 else 0) > 2 ^ SEW - 1,
         VVM_VMSBC    => unsigned(vs2_val[i]) - unsigned(vs1_val[i]) - (if vm_val[i] == 0b1 then 1 else 0) < 0
       };
       result[i] = bool_to_bit(res)
@@ -98,7 +100,9 @@ function clause execute VVMCTYPE(funct6, vs2, vs1, vd) = {
   if illegal_vstart(VSTART_ARITH, num_elem, LMUL_pow) |
      illegal_vd_unmasked()  |
      not(valid_reg_group(vs1, LMUL_pow)) |
-     not(valid_reg_group(vs2, LMUL_pow))
+     not(valid_reg_group(vs2, LMUL_pow)) |
