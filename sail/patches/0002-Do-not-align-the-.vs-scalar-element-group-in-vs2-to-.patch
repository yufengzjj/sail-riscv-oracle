From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: yufengzjj <yufeng.zjj@gmail.com>
Date: Wed, 21 Oct 2026 12:20:00 +0000
Subject: [PATCH 2/5] Do not align the .vs scalar element group in vs2 to LMUL

The vector crypto spec says scalar element group operands need not be
aligned to LMUL when VLEN >= EGW: vs2 is the ceil(128 / VLEN) registers
holding one 128-bit element group, and vd must only avoid those. The
.vs forms of vaesdf/vaesdm/vaesef/vaesem/vaesz/vsm4r required vs2 to be
LMUL-aligned and treated it as an LMUL group in the overlap check, so
e.g. vaesz.vs v4, v3 with LMUL=2 was rejected.

vs2 element groups are now read straight from the registers, so the .vs
forms no longer read a whole LMUL group starting at vs2.
---
 model/extensions/vector_crypto/zvk_utils.sail | 21 +++++++++
 .../vector_crypto/zvkned_insts.sail           | 47 +++++++++----------
 .../vector_crypto/zvksed_insts.sail           | 10 ++--
 3 files changed, 49 insertions(+), 29 deletions(-)

diff --git a/model/extensions/vector_crypto/zvk_utils.sail b/model/extensions/vector_crypto/zvk_utils.sail
index 6d0e05ee..5f854e01 100644
--- a/model/extensions/vector_crypto/zvk_utils.sail
+++ b/model/extensions/vector_crypto/zvk_utils.sail
@@ -13,6 +13,27 @@ function zvk_valid_reg_overlap(rs : vregidx, rd : vregidx, emul_pow : int) -> bo
   (rs_int + reg_group_size <= rd_int) | (rd_int + reg_group_size <= rs_int)
 }
 
+// The 128-bit scalar element group of the .vs forms occupies ceil(128 / VLEN)
+// registers whatever LMUL is, so vs2 is aligned to that rather than to LMUL.
+function zvk_vs_emul_pow() -> nat = max(0, 7 - vlen_exp)
+
+// For the .vs forms: the vd register group must not overlap the vs2 scalar
+// element group.
+function zvk_valid_vs_reg_overlap(vs2 : vregidx, vd : vregidx, lmul_pow : int) -> bool = {
+  let vs2_group = 2 ^ zvk_vs_emul_pow();
+  let vd_group = 2 ^ max(lmul_pow, 0);
+  let vs2_int = unsigned(vregidx_bits(vs2));
+  let vd_int = unsigned(vregidx_bits(vd));
+  (vs2_int + vs2_group <= vd_int) | (vd_int + vd_group <= vs2_int)
+}
+
+// Element group i (four 32-bit elements) of the register group starting at vs,
+// in the order of get_velem_quad_vec.
+val zvk_read_eg32x4 : (vregidx, nat) -> vector(4, bits(32))
+function zvk_read_eg32x4(vs, i) =
+  [read_single_element(32, 4 * i + 3, vs), read_single_element(32, 4 * i + 2, vs),
+   read_single_element(32, 4 * i + 1, vs), read_single_element(32, 4 * i, vs)]
+
 function zvk_check_encdec(EGW : nat, EGS : nat1) -> bool = {
   let LMUL_pow = get_lmul_pow();
   let LMUL_times_VLEN = if LMUL_pow < 0 then vlen / (2 ^ abs_int(LMUL_pow)) else (2 ^ LMUL_pow) * vlen;
